<!DOCTYPE html>
<head>
    <link href="{$config['wiki.logo_url']}" rel="SHORTCUT ICON">
    <meta charset="UTF-8">
    <meta name="author" content="PRASEOD-">
    <meta name="title" content="{$config['wiki.site_name']}">
    <meta name="description" content="{$config['wiki.description']}">
    <meta name="monaco-version" content="{$config['wiki.editor_version']}">
    <meta http-equiv="Content-Type" content="text/html;">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{$config['wiki.site_name']}">
    <meta property="og:description" content="{$config['wiki.description']}">
    <meta name="format-detection" content="telephone=no">
    <script defer src="/src/script/main.js"></script>
    <script src="/src/script/jquery-2.2.4.min.js"></script>
    <script src="/src/script/tether.min.js"></script>
    <script src="/src/script/bootstrap.min.js"></script>
    <script defer n:if="$wiki['page']['view_name'] == 'mypage' || $wiki['page']['data']['use_webauthn']" src="/src/script/webauthn.js"></script>
    <title> {$wiki['page']['title']} - {$config['wiki.site_name']} </title>
    {if $wiki['page']['view_name'] == 'wiki'}
        <link rel="stylesheet" href="/src/style/document.css">
        <script defer src="/src/script/document.js"></script>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.11.1/dist/katex.min.css" integrity="sha384-zB1R0rpPzHqg7Kpt0Aljp8JPLqbXI3bhnPWROx27a9N0Ll6ZP/+DiW/UqRcLbRjq" crossorigin="anonymous"/>
        <script defer src="https://cdn.jsdelivr.net/npm/katex@0.11.1/dist/katex.min.js" integrity="sha384-y23I5Q6l+B6vatafAwxRu/0oK/79VlbSz7Q9aiSZUvyWYIYsd+qj+o24G5ZU2zJz" crossorigin="anonymous"></script>
        <script defer src="https://cdn.jsdelivr.net/npm/katex@0.11.1/dist/contrib/auto-render.min.js" integrity="sha384-kWPLUVMOks5AQFrykwIup5lo0m3iMkkHrD0uJ4H5cjeGihAutqP0yW0J6dpFiVkI" crossorigin="anonymous" onload="renderMathInElement(document.body);"></script>
    {/if}
    {if $wiki['page']['view_name'] == 'edit'}
        <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/{$config['wiki.editor_version']}/min/vs/loader.js"></script>
        <script src="/src/script/monaco.js"></script>
    {/if}
    {foreach $skinConfig['js'] as $sf}
        <link rel="preload" as="script" href="/skins/{$skinName}/{$sf['path']|noCheck}">
        <script defer src="/skins/{$skinName}/{$sf['path']|noCheck}"></script>
    {/foreach}
    {$skinConfig['additional_heads']|implode|noescape}
    <style>
    @import "/src/style/bootstrap.min.css" layer(skin);</style>
    <link rel="stylesheet" href="/src/style/base.css">
</head>
<body>
    <script>
        try {
            switch (JSON.parse(localStorage.getItem("pressdo_settings") || "{}")["wiki.theme"]) {
            case void 0:
            case "auto":
                var e,
                    a = matchMedia("(prefers-color-scheme: dark)");
                a && (e = a.matches ? 1 : 0);
                break;
            case "dark":
                e = 1;
                break;
            default:
                e = 0
            }
            var s = document.body.classList,
                t = "pressdo-dark-mode",
                d = "pressdo-light-mode";
            e ? (s.add(t), s.remove(d)) : (s.add(d), s.remove(t))
        } catch (r) {}
    </script>
    <div id="app">
        <div class="{$skinConfig['body_classes']|implode:' '}">
            {$body|noescape}
        </div>
    </div>
</body>