<div n:if="$wiki['page']['data']['error']" class="a e">
    <strong>{$lang['msg']['error']}</strong>
    <span>{$lang['msg'][$wiki['page']['data']['error']]}</span>
</div>
<ul class="lists">
    <li n:foreach="$wiki['page']['data']['starred_documents'] as $doc">
        <a href="/w/{$doc['title']}">{$doc['title']}</a> (수정시각: {$doc['datetime']|localdate|noescape})
    </li>
</ul>