<div n:if="$wiki['page']['data']['error']" class="a e">
    <strong>{$lang['msg']['error']}</strong>
    <span>{$lang['msg'][$wiki['page']['data']['error']]}</span>
</div>
<div class="recent-changes recent-table">
    <div class="starred-tr recent-th">
        <div class="recent-td">{$lang['recent']['document']}</div>
        <div class="recent-td">{$lang['recent']['modified_time']}</div>
        <div class="recent-td"></div>
    </div>
    {foreach $wiki['page']['data']['starred_documents'] as $doc}
        {var $title = ($doc['title']|makeTitle: $doc['namespace'])}
        <div class="starred-tr">
            <div class="starred-td">
                <a href="/w/{$title|escapeUrl}">{$title}</a>
            </div>
            <div class="starred-td recent-datetime">{$doc['datetime']|localreldate|noescape}</div>
            <div class="starred-td recent-btn recent-tool">
                <a class="pressdo-btn btn-round btn-square btn-darkred" role="button" href="/member/unstar/{$title|escapeUrl}" title="{$lang['btn']['delete']}">
                    <svg class="mobile-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path d="M135.2 17.7C140.6 6.8 151.7 0 163.8 0H284.2c12.1 0 23.2 6.8 28.6 17.7L320 32h96c17.7 0 32 14.3 32 32s-14.3 32-32 32H32C14.3 96 0 81.7 0 64S14.3 32 32 32h96l7.2-14.3zM32 128H416V448c0 35.3-28.7 64-64 64H96c-35.3 0-64-28.7-64-64V128zm96 64c-8.8 0-16 7.2-16 16V432c0 8.8 7.2 16 16 16s16-7.2 16-16V208c0-8.8-7.2-16-16-16zm96 0c-8.8 0-16 7.2-16 16V432c0 8.8 7.2 16 16 16s16-7.2 16-16V208c0-8.8-7.2-16-16-16zm96 0c-8.8 0-16 7.2-16 16V432c0 8.8 7.2 16 16 16s16-7.2 16-16V208c0-8.8-7.2-16-16-16z"></path></svg>
                    <span class="mobile-hidden">{$lang['btn']['delete']}</span>
                </a>
            </div>
        </div>
    {/foreach}
</div>